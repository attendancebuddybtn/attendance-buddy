DTSTAMP:20261102T000000Z
DTSTART;TZID=Asia/Kolkata:20261118T100000
DTEND;TZID=Asia/Kolkata:20261118T101500
RRULE:FREQ=MONTHLY;BYMONTHDAY=18
SUMMARY:Apply leave by the 20th
DESCRIPTION:Check your biometric page for ULOP\, LOP or Incomplete days and
  apply Casual\, Medical or Academic leave (or On Duty if you worked away) 
 before the 20th.
