BEGIN:VEVENT
UID:punch-in-weekdays@attendance-buddy
DTSTAMP:20261102T000000Z
DTSTART;TZID=Asia/Kolkata:20261102T095000
DTEND;TZID=Asia/Kolkata:20261102T100000
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR
SUMMARY:Punch in by 10:00 (biometric)
DESCRIPTION:On time = punch-in between 6:00 and 10:00 AM. No punch at all =
  ULOP.\nHoliday or on leave today? Just dismiss this.
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Punch in by 10:00 (biometric)
TRIGGER:-PT20M
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Last call: punch in before 10:00
TRIGGER:PT0M
END:VALARM
END:VEVENT
